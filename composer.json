{
    "name": "yikai/yikaicms",
    "description": "A lightweight enterprise CMS built with PHP 8.0+, no framework dependency.",
    "type": "project",
    "keywords": ["cms", "content-management", "php", "enterprise", "lightweight"],
    "homepage": "https://www.yikaicms.com",
    "license": "proprietary",
    "authors": [
        {
            "name": "Yikai",
            "homepage": "https://www.yikaicms.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "vimeo/psalm": "6.4.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Yikai\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text",
        "psalm": "psalm --no-progress",
        "lint": "find . -path ./vendor -prune -o -path ./node_modules -prune -o -name '*.php' -print0 | xargs -0 -n1 -P4 php -l > /dev/null"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
