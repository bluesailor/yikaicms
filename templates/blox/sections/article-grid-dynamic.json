{
    "format": "yikaicms-blox-template",
    "version": 1,
    "type": "section",
    "name": "Dynamic article grid",
    "requires": {"elements": ["heading", "text", "list-dynamic"], "plugins": []},
    "document": {"schema": 1, "settings": {}, "sections": [{
        "type": "section",
        "name": "动态资讯网格",
        "settings": {"padding": {"d": "xl", "m": "lg"}, "max_width": "wide", "gap": "lg"},
        "columns": [
            {"elements": [{"type": "heading", "data": {"text": "最新资讯", "level": "h2", "visual_size": {"d": "3xl", "m": "2xl"}, "align": "left"}}, {"type": "text", "data": {"html": "<p class=\"yk-copy\">发布新的文章后，列表自动反映最新内容。</p>"}}]},
            {"elements": [{"type": "list-dynamic", "data": {"query_source": "type:article", "limit": 6, "order": "newest", "show_image": true, "show_title": true, "show_summary": true, "show_date": true, "item_preset": "card", "image_ratio": "landscape", "columns": "3", "empty_mode": "message", "empty": "暂无可展示的资讯"}}]}
        ]
    }]}
}
