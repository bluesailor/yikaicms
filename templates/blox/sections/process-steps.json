                    {"type": "process-step", "data": {"number": "02", "icon": "clipboard-check", "title": "方案与报价", "text": "确认实施方案、交付清单与费用。"}},
                    {"type": "process-step", "data": {"number": "03", "icon": "tool", "title": "执行与验收", "text": "按里程碑推进，并依据标准逐项验收。"}},
                    {"type": "process-step", "data": {"number": "04", "icon": "headset", "title": "交付后支持", "text": "提供文档、培训与持续服务响应。"}}
                ]}}
            ]}]
        }]
