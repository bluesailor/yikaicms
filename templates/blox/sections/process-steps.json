{
    "format": "yikaicms-blox-template",
    "version": 1,
    "type": "section",
    "name": "Four-step process",
    "requires": {"elements": ["heading", "text", "process-steps", "process-step"], "plugins": []},
    "document": {
        "schema": 1,
        "settings": {},
        "sections": [{
            "type": "section",
            "name": "四步服务流程",
            "settings": {"padding": {"d": "xl", "m": "lg"}, "max_width": "wide", "gap": "lg"},
            "columns": [{"elements": [
                {"type": "heading", "data": {"text": "合作流程", "level": "h2", "visual_size": {"d": "3xl", "m": "2xl"}, "align": "center"}},
                {"type": "text", "data": {"html": "<p class=\"yk-lead text-center\">四个清晰节点，让目标、进度与交付结果始终可确认。</p>"}},
                {"type": "process-steps", "data": {"auto_number": true, "tablet_columns": "2", "desktop_columns": "4", "gap": "lg", "children": [
