{
  "format": "yikaicms-blox-template",
  "version": 1,
  "type": "footer",
  "name": "Business Theme Footer",
  "requires": {
    "elements": ["nav", "site-copyright"],
    "plugins": []
  },
  "document": {
    "schema": 1,
    "settings": {},
    "sections": [
      {
        "type": "section",
        "settings": {
          "padding": "sm",
          "max_width": "wide",
          "gap": "none",
          "bg_color": "#0f172a",
          "align_items": "center"
        },
        "columns": [
          {
            "elements": [
              {"type": "nav", "data": {"menu_group": 0, "parent": "", "nav_only": true, "dropdown": false, "wrap_class": "flex flex-wrap justify-center gap-x-8 gap-y-3 text-sm text-gray-300"}}
            ]
          }
        ]
      },
      {
        "type": "section",
        "settings": {
          "padding": "sm",
          "max_width": "wide",
          "gap": "none",
          "bg_color": "#020617"
        },
        "columns": [
          {
            "elements": [
              {"type": "site-copyright", "data": {"show_icp": true, "show_police": true, "align": "center", "tone": "light"}}
            ]
          }
        ]
      }
    ]
  }
}
