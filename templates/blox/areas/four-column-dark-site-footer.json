{
  "format": "yikaicms-blox-template",
  "version": 1,
  "type": "footer",
  "name": "Four Column Dark Site Footer",
  "requires": {
    "elements": ["logo", "nav", "site-contact", "site-copyright", "site-filing", "site-search", "social-links", "text"],
    "plugins": []
  },
  "document": {
    "schema": 1,
    "settings": {},
    "sections": [
      {
        "type": "section",
        "settings": {
          "padding": "xl",
          "max_width": "wide",
          "gap": "lg",
          "bg_color": "#18181b",
          "align_items": "start",
          "tablet_stack": true
        },
        "columns": [
          {
            "span": 3,
            "elements": [
              {"type": "logo", "data": {"display": "text", "height": "md", "tone": "light", "link_home": true}},
              {"type": "text", "data": {"site_field": "site_description", "color": "#a1a1aa"}}
            ]
          },
          {
            "span": 3,
            "elements": [
              {"type": "nav", "data": {"menu_group": 0, "parent": "", "nav_only": true, "dropdown": false, "wrap_class": "flex flex-col gap-2 text-sm text-gray-300"}}
            ]
          },
          {
            "span": 3,
            "elements": [
              {"type": "site-contact", "data": {"show_phone": true, "show_email": true, "show_address": true, "show_hours": true, "show_icons": true, "layout": "stacked", "tone": "light"}}
            ]
          },
          {
            "span": 3,
            "elements": [
              {"type": "site-search", "data": {"layout": "compact", "show_label": true, "tone": "light"}},
              {"type": "social-links", "data": {"style": "outline", "align": "left", "tone": "light"}}
            ]
          }
        ]
      },
      {
        "type": "section",
        "settings": {
          "padding": "sm",
          "max_width": "wide",
          "gap": "none",
          "bg_color": "#09090b"
        },
        "columns": [
          {
            "span": 12,
            "elements": [
              {"type": "site-copyright", "data": {"show_icp": false, "show_police": false, "align": "center", "tone": "light"}},
              {"type": "site-filing", "data": {"show_icp": true, "show_police": true, "align": "center", "tone": "light"}}
            ]
          }
        ]
      }
    ]
  }
}
