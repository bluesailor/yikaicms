{
  "format": "yikaicms-blox-template",
  "version": 1,
  "type": "footer",
  "name": "Search Site Footer",
  "requires": {
    "elements": ["logo", "nav", "site-contact", "site-copyright", "site-search", "social-links"],
    "plugins": []
  },
  "document": {
    "schema": 1,
    "settings": {},
    "sections": [
      {
        "type": "section",
        "settings": {
          "padding": "lg",
          "max_width": "wide",
          "gap": "lg",
          "bg_color": "#111827",
          "align_items": "center",
          "tablet_stack": true
        },
        "columns": [
          {
            "span": 4,
            "elements": [
              {"type": "logo", "data": {"display": "image", "height": "md", "tone": "light", "link_home": true}}
            ]
          },
          {
            "span": 8,
            "elements": [
              {"type": "site-search", "data": {"layout": "wide", "show_label": true, "tone": "light"}}
            ]
          }
        ]
      },
      {
        "type": "section",
        "settings": {
          "padding": "lg",
          "max_width": "wide",
          "gap": "xl",
          "bg_color": "#1f2937",
          "align_items": "start",
          "tablet_stack": true
        },
        "columns": [
          {
            "span": 7,
            "elements": [
              {"type": "nav", "data": {"menu_group": 0, "parent": "", "nav_only": true, "dropdown": false, "wrap_class": "flex flex-wrap gap-x-5 gap-y-2 text-sm text-gray-300"}}
            ]
          },
          {
            "span": 5,
            "elements": [
              {"type": "site-contact", "data": {"show_phone": true, "show_email": true, "show_address": false, "show_hours": false, "show_icons": true, "layout": "stacked", "tone": "light"}}
            ]
          }
        ]
      },
      {
        "type": "section",
        "settings": {
          "padding": "sm",
          "max_width": "wide",
          "gap": "md",
          "bg_color": "#030712",
          "align_items": "center",
          "tablet_stack": true
        },
        "columns": [
          {
            "span": 8,
            "elements": [
              {"type": "site-copyright", "data": {"show_icp": true, "show_police": true, "align": "left", "tone": "light"}}
            ]
          },
          {
            "span": 4,
            "elements": [
              {"type": "social-links", "data": {"style": "outline", "align": "right", "tone": "light"}}
            ]
          }
        ]
      }
    ]
  }
}
