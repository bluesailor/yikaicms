{
  "format": "yikaicms-blox-template",
  "version": 1,
  "type": "header",
  "name": "Full Width Site Header",
  "requires": {
    "elements": ["container", "logo", "nav-mega", "nav-drawer"],
    "plugins": []
  },
  "document": {
    "schema": 1,
    "settings": {"sticky": false},
    "sections": [
      {
        "type": "section",
        "settings": {
          "padding": "none",
          "max_width": "full",
          "container_gutter": "none",
          "gap": "none",
          "bg_color": "#ffffff"
        },
        "columns": [
          {
            "elements": [
              {
                "type": "container",
                "data": {
                  "direction": "row",
                  "wrap": "nowrap",
                  "gap": "md",
                  "align": "center",
                  "justify": "between",
                  "padding": "sm",
                  "radius": "none",
                  "children": [
                    {"type": "logo", "data": {"display": "image", "height": "md", "link_home": true}},
                    {"type": "nav-mega", "data": {"menu_group": 0, "show_desc": false, "full_width": true}},
                    {"type": "nav-drawer", "data": {"menu_group": 0, "side": "right", "show_logo": true}}
                  ]
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
