    "elements": [
      "container",
      "icon",
      "text"
    ],
    "plugins": []
  },
  "component": {
    "uuid": "cmp_644b99231e88fe58",
    "category": "content",
    "description": "一个图标加一行文字，适合列优势、资质或服务承诺。"
  },
  "names": {
