              {
                "id": "e_root",
                "type": "container",
                "data": {
                  "layout": "flex",
                  "direction": {
                    "d": "row"
                  },
                  "align": {
                    "d": "center"
                  },
                  "gap": {
                    "d": "sm"
                  },
                  "children": [
                    {
                      "id": "e_icon",
                      "type": "icon",
                      "data": {
                        "icon": "circle-check",
                        "size": "md",
                        "color": "#16a34a"
