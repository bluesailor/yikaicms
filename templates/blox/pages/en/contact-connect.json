{
  "format": "yikaicms-blox-template",
  "version": 1,
  "type": "page",
  "name": "Contact Us",
  "thumbnail": "/assets/images/blox-templates/contact-connect.png",
  "requires": {
    "elements": ["heading", "text", "button", "div", "icon-box", "contact_cards", "contact_form", "contact_map", "site-contact", "accordion"],
    "plugins": []
  },
  "document": {
    "schema": 1,
    "settings": {},
    "sections": [
      {
        "type": "section",
        "name": "Contact Intro",
        "settings": {
          "padding": { "d": "xl", "m": "lg" },
          "max_width": "wide",
          "gap": "xl",
          "content_v_align": "center",
          "bg_color": "#0f172a",
          "text_tone": "light"
        },
        "columns": [
          {
            "span": 7,
            "elements": [
              {
                "type": "text",
                "data": { "html": "<p><strong>CONTACT US</strong></p>" }
              },
              {
                "type": "heading",
                "data": {
                  "text": "Tell us what you need, and we'll connect you with the right person",
                  "level": "h1",
                  "visual_size": { "d": "5xl", "t": "4xl", "m": "3xl" },
                  "align": "left"
                }
              },
              {
                "type": "text",
                "data": {
                  "html": "<p>Whether it's a product inquiry, a project partnership or an after-sales question, you can reach us through any of the channels below. Add a one-line service promise here, such as your response time, service scope or how you handle inquiries.</p>"
                }
              },
              {
                "type": "div",
                "data": {
                  "display": "flex",
                  "direction": "row",
                  "wrap": "wrap",
                  "gap": "sm",
                  "align": "center",
                  "children": [
                    {
                      "type": "button",
                      "data": { "text": "Send a Message", "url": "#message", "variant": "primary", "icon": "message-circle", "icon_position": "left" }
                    },
                    {
                      "type": "button",
                      "data": { "text": "Visit Us", "url": "#visit", "variant": "outline", "color": "#ffffff", "icon": "map-pin", "icon_position": "left" }
                    }
                  ]
                }
              }
            ]
          },
          {
            "span": 5,
            "elements": [
              {
                "type": "div",
                "data": {
                  "display": "flex",
                  "direction": "column",
                  "gap": "lg",
                  "padding": "lg",
                  "radius": "xl",
                  "bg_color": "#1e293b",
                  "children": [
                    {
                      "type": "icon-box",
                      "data": { "icon": "clock-hour-4", "title": "Reply within 1 business day", "text": "Messages received during business hours are assigned to a dedicated contact the same day.", "icon_layout": "side", "icon_surface": "circle" }
                    },
                    {
                      "type": "icon-box",
                      "data": { "icon": "user-check", "title": "One dedicated contact", "text": "Your request goes straight to the right specialist, so you never have to repeat yourself.", "icon_layout": "side", "icon_surface": "circle" }
                    },
                    {
                      "type": "icon-box",
                      "data": { "icon": "shield-lock", "title": "Strictly confidential", "text": "Your contact details are used only for this inquiry and never shared.", "icon_layout": "side", "icon_surface": "circle" }
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      {
        "type": "section",
        "name": "Contact Details",
        "settings": {
          "padding": { "d": "lg", "m": "md" },
          "max_width": "wide",
          "gap": "md",
          "bg_color": "#f8fafc"
        },
        "columns": [
          {
            "elements": [
              {
                "type": "contact_cards",
                "data": { "card_layout": "classic", "cols": "auto", "card_align": "center", "show_icons": true, "icon_surface": "circle", "card_gap": "md" }
              }
            ]
          }
        ]
      },
      {
        "type": "section",
        "name": "Send a Message",
        "settings": {
          "padding": { "d": "xl", "m": "lg" },
          "max_width": "wide",
          "gap": "xl",
          "anchor_id": "message"
        },
        "columns": [
          {
            "span": 5,
            "elements": [
              {
                "type": "heading",
                "data": { "text": "Share your needs and we'll get back to you", "level": "h2", "visual_size": { "d": "3xl", "m": "2xl" }, "align": "left" }
              },
              {
                "type": "text",
                "data": {
                  "html": "<p class=\"yk-copy\">The more detail you share, the more precise our reply. It helps to include:</p><ul class=\"yk-copy\"><li>The problem you want to solve or the products you need</li><li>Approximate quantity, budget or timeline</li><li>The best time to reach you</li></ul>"
                }
              },
              {
                "type": "site-contact",
                "data": { "show_phone": true, "show_email": true, "show_address": false, "show_hours": true, "show_icons": true, "layout": "stacked", "tone": "dark" }
              }
            ]
          },
          {
            "span": 7,
            "elements": [
              { "type": "contact_form", "data": {} }
            ]
          }
        ]
      },
      {
        "type": "section",
        "name": "Visit Us",
        "settings": {
          "padding": { "d": "xl", "m": "lg" },
          "max_width": "wide",
          "gap": "xl",
          "content_v_align": "center",
          "bg_color": "#f8fafc",
          "anchor_id": "visit"
        },
        "columns": [
          {
            "span": 7,
            "elements": [
              { "type": "contact_map", "data": {} }
            ]
          },
          {
            "span": 5,
            "elements": [
              {
                "type": "heading",
                "data": { "text": "Meet us in person", "level": "h2", "visual_size": { "d": "3xl", "m": "2xl" }, "align": "left" }
              },
              {
                "type": "text",
                "data": {
                  "html": "<p class=\"yk-copy\">Please call ahead to book your visit so we can arrange for the right team member to meet you. Add directions here, such as the nearest subway station, parking or the building entrance.</p>"
                }
              },
              {
                "type": "site-contact",
                "data": { "show_phone": false, "show_email": false, "show_address": true, "show_hours": true, "show_icons": true, "layout": "stacked", "tone": "dark" }
              }
            ]
          }
        ]
      },
      {
        "type": "section",
        "name": "Contact by Topic",
        "settings": {
          "padding": { "d": "xl", "m": "lg" },
          "max_width": "wide",
          "gap": "lg",
          "col_card": true
        },
        "columns": [
          {
            "elements": [
              {
                "type": "icon-box",
                "data": { "icon": "briefcase", "title": "Business Partnerships", "text": "For purchasing, distribution or project partnerships, please include your company name and the type of partnership.", "icon_layout": "top", "icon_surface": "circle" }
              }
            ]
          },
          {
            "elements": [
              {
                "type": "icon-box",
                "data": { "icon": "headset", "title": "After-Sales Support", "text": "If you run into an issue, please include the product model, purchase date and a description of the problem.", "icon_layout": "top", "icon_surface": "circle" }
              }
            ]
          },
          {
            "elements": [
              {
                "type": "icon-box",
                "data": { "icon": "users", "title": "Join Us", "text": "Send your résumé to our careers email and put the position you're applying for in the subject line.", "icon_layout": "top", "icon_surface": "circle" }
              }
            ]
          }
        ]
      },
      {
        "type": "section",
        "name": "Before You Contact Us",
        "settings": {
          "padding": { "d": "xl", "m": "lg" },
          "max_width": "narrow",
          "gap": "md",
          "bg_color": "#f8fafc"
        },
        "columns": [
          {
            "elements": [
              {
                "type": "heading",
                "data": { "text": "Before You Contact Us", "level": "h2", "visual_size": { "d": "3xl", "m": "2xl" }, "align": "center" }
              },
              {
                "type": "accordion",
                "data": {
                  "items": [
                    { "question": "How soon will I hear back after sending a message?", "answer": "Messages sent on business days are usually answered the same day; those sent on holidays are answered the next business day." },
                    { "question": "Can I request a quote or product information first?", "answer": "Yes. Include the product model or a description of your requirements in your message, and we'll email you the information and a quote." },
                    { "question": "Do I need an appointment to visit?", "answer": "We recommend calling a day in advance so we can arrange the right team member and prepare a demo." }
                  ],
                  "open_first": true,
                  "seo_schema": true
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
