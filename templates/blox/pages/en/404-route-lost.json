{
  "format": "yikaicms-blox-template",
  "version": 1,
  "type": "page",
  "name": "404 Route Lost",
  "thumbnail": "/assets/images/blox-templates/404-route-lost.png",
  "requires": {
    "elements": ["button", "divider", "div", "heading", "text"],
    "plugins": []
  },
  "document": {
    "schema": 1,
    "settings": {},
    "sections": [
      {
        "type": "section",
        "name": "404 Access Panel",
        "settings": {
          "padding": {"d": "xl", "m": "lg"},
          "gap": "none",
          "max_width": "custom",
          "max_width_px": 760,
          "min_height": "screen",
          "content_v_align": "center",
          "bg_color": "#f7f7f5"
        },
        "columns": [
          {
            "elements": [
              {
                "type": "heading",
                "data": {
                  "text": "404",
                  "level": "h1",
                  "visual_size": {"d": "display", "t": "6xl", "m": "5xl"},
                  "color": "#dededb",
                  "align": "center",
                  "style_margin_bottom": "-2rem"
                }
              },
              {
                "type": "div",
                "data": {
                  "display": "flex",
                  "direction": "column",
                  "wrap": "nowrap",
                  "gap": "sm",
                  "align": "stretch",
                  "justify": "start",
                  "bg_color": "#dededddd",
                  "padding": {"d": "lg", "m": "md"},
                  "radius": "xl",
                  "children": [
                    {
                      "type": "text",
                      "data": {
                        "html": "<p class=\"yk-404-meta-row\"><span>Return route</span><span>Access denied</span></p>"
                      }
                    },
                    {
                      "type": "divider",
                      "data": {"color": "#b9b9b5", "style": "solid", "width": 1, "spacing": "sm"}
                    },
                    {
                      "type": "text",
                      "data": {"html": "<p class=\"yk-404-label\">Destination</p>"}
                    },
                    {
                      "type": "heading",
                      "data": {
                        "text": "Page 404",
                        "level": "h2",
                        "visual_size": {"d": "4xl", "m": "3xl"},
                        "color": "#50504d",
                        "align": "left",
                        "style_margin_bottom": "none"
                      }
                    },
                    {
                      "type": "text",
                      "data": {"html": "<p class=\"yk-404-value\">The address is valid, but this page never arrived.</p>"}
                    }
                  ]
                }
              },
              {
                "type": "text",
                "data": {
                  "html": "<p class=\"yk-404-desc\">The page you're looking for may have been moved, deleted, or never existed.</p>"
                }
              },
              {
                "type": "button",
                "data": {
                  "text": "Back to Home",
                  "url": "/",
                  "new_tab": false,
                  "align": "center",
                  "variant": "dark",
                  "shape": "pill"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
