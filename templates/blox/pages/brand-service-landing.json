{
  "format": "yikaicms-blox-template",
  "version": 1,
  "type": "page",
  "name": "品牌服务落地页",
  "thumbnail": "/assets/images/blox-templates/landing-brand-hero.png",
  "requires": {
    "elements": ["heading", "text", "image", "button", "divider", "card", "stats-group", "stat-item", "quote", "icon-box", "contact_form", "accordion", "cta"],
    "plugins": []
  },
  "document": {
    "schema": 1,
    "settings": {},
    "sections": [
      {
        "type": "section",
        "name": "首屏引导",
        "settings": {
          "padding": { "d": "xl", "m": "lg" },
          "max_width": "wide",
          "gap": "xl",
          "content_v_align": "center",
          "bg_color": "#f8fafc"
        },
        "columns": [
          {
            "elements": [
              { "type": "text", "data": { "html": "<p class=\"yk-eyebrow\">Brand service</p>" } },
              { "type": "heading", "data": { "text": "让复杂的业务，变成清晰的下一步", "level": "h1", "visual_size": { "d": "5xl", "t": "4xl", "m": "3xl" }, "align": "left" } },
              { "type": "text", "data": { "html": "<p class=\"yk-lead\">从策略、设计到数字化交付，我们帮助企业把专业能力讲清楚，把客户决策推进得更顺畅。</p>" } },
              { "type": "button", "data": { "text": "预约一次方案沟通", "url": "/contact.html", "variant": "primary", "align": "left" } },
              { "type": "button", "data": { "text": "查看服务能力", "url": "/service.html", "variant": "outline", "align": "left" } }
            ]
          },
          {
            "elements": [
              { "type": "image", "data": { "src": "/assets/images/blox-templates/landing-brand-hero.png", "alt": "现代企业服务与智能制造场景" } }
            ]
          }
        ]
      },
      {
        "type": "section",
        "name": "品牌说明",
        "settings": { "padding": { "d": "xl", "m": "lg" }, "max_width": "wide", "gap": "xl", "content_v_align": "center" },
        "columns": [
          {
            "elements": [
              { "type": "image", "data": { "src": "/assets/images/blox-templates/landing-brand-about.png", "alt": "团队讨论产品方案" } }
            ]
          },
          {
            "elements": [
              { "type": "text", "data": { "html": "<p class=\"yk-eyebrow\">About the studio</p>" } },
              { "type": "heading", "data": { "text": "把专业能力，变成客户看得懂的价值", "level": "h2", "visual_size": { "d": "3xl", "m": "2xl" }, "align": "left" } },
              { "type": "divider", "data": { "style": "solid", "width": 3, "color": "#2563eb", "spacing": "sm" } },
              { "type": "text", "data": { "html": "<p class=\"yk-copy\">我们和业务、产品与交付团队一起工作，先梳理真实场景，再设计能够落地的解决方案。</p><p class=\"yk-copy\">每一个页面、流程和工具都服务于同一个目标：让客户更快理解你，让团队更稳定地交付。</p>" } },
              { "type": "button", "data": { "text": "了解我们的方式", "url": "/about/company.html", "variant": "outline", "align": "left" } }
            ]
          }
        ]
      },
      {
        "type": "section",
        "name": "服务能力",
        "settings": { "padding": { "d": "xl", "m": "lg" }, "max_width": "wide", "gap": "lg", "bg_color": "#f8fafc" },
        "columns": [
          {
            "elements": [
              { "type": "heading", "data": { "text": "从想法到结果，提供完整的服务能力", "level": "h2", "visual_size": { "d": "3xl", "m": "2xl" }, "align": "center" } },
              { "type": "text", "data": { "html": "<p class=\"yk-hint-center\">把常见的合作内容拆成清晰的服务模块，方便客户快速找到适合自己的下一步。</p>" } }
            ]
          }
        ]
      },
      {
        "type": "section",
        "name": "服务卡片",
        "settings": { "padding": { "d": "md", "m": "sm" }, "max_width": "wide", "gap": "lg" },
        "columns": [
          { "elements": [ { "type": "card", "data": { "image": "/assets/images/blox-templates/landing-brand-service-calibration.png", "title": "方案设计", "text": "从业务目标、用户场景和实施边界出发，形成可执行的方案与计划。", "link": "/service/process.html" } } ] },
          { "elements": [ { "type": "card", "data": { "image": "/assets/images/blox-templates/landing-brand-service-control.png", "title": "数字化交付", "text": "用清晰的流程和可追踪的节点，把复杂项目稳定交付到客户团队。", "link": "/service/process.html" } } ] },
          { "elements": [ { "type": "card", "data": { "image": "/assets/images/blox-templates/landing-brand-about.png", "title": "持续运营", "text": "交付不是终点，持续复盘、优化与支持，让成果长期产生价值。", "link": "/contact.html" } } ] }
        ]
      },
      {
        "type": "section",
        "name": "关键成果",
        "settings": { "padding": { "d": "lg", "m": "md" }, "max_width": "wide", "bg_color": "#eff6ff" },
        "columns": [
          {
            "elements": [
              { "type": "stats-group", "data": { "desktop_columns": "4", "tablet_columns": "2", "mobile_columns": "2", "gap": "lg", "counter_enabled": true, "counter_start": 0, "counter_duration": 1600, "children": [
                { "type": "stat-item", "data": { "icon": "calendar", "number": "12", "label": "年行业经验" } },
                { "type": "stat-item", "data": { "icon": "users", "number": "3000+", "label": "服务客户" } },
                { "type": "stat-item", "data": { "icon": "briefcase", "number": "96%", "label": "项目按期交付" } },
                { "type": "stat-item", "data": { "icon": "headset", "number": "24h", "label": "平均响应时间" } }
              ] } }
            ]
          }
        ]
      },
      {
        "type": "section",
        "name": "客户反馈",
        "settings": { "padding": { "d": "xl", "m": "lg" }, "max_width": "narrow", "content_v_align": "center" },
        "columns": [
          {
            "elements": [
              { "type": "text", "data": { "html": "<p class=\"yk-eyebrow yk-center\">Customer feedback</p>" } },
              { "type": "heading", "data": { "text": "客户反馈：合作结果，应该经得起复盘", "level": "h2", "visual_size": { "d": "3xl", "m": "2xl" }, "align": "center" } },
              { "type": "quote", "data": { "text": "他们把复杂的项目拆成了清楚的步骤，团队知道今天要做什么，客户也能及时看到进展。", "author": "某制造企业 · 数字化负责人" } }
            ]
          }
        ]
      },
      {
        "type": "section",
        "name": "团队协作",
        "settings": { "padding": { "d": "xl", "m": "lg" }, "max_width": "wide", "gap": "xl", "content_v_align": "center", "bg_color": "#f8fafc" },
        "columns": [
          {
            "elements": [
              { "type": "text", "data": { "html": "<p class=\"yk-eyebrow\">How we work</p>" } },
              { "type": "heading", "data": { "text": "一支懂业务，也懂交付的团队", "level": "h2", "visual_size": { "d": "3xl", "m": "2xl" }, "align": "left" } },
              { "type": "text", "data": { "html": "<p class=\"yk-copy\">策略、设计、技术和客户成功保持在同一张项目地图上，让决策更快、沟通更少、交付更透明。</p>" } },
              { "type": "icon-box", "data": { "icon": "users", "title": "跨职能协作", "text": "每个关键节点都有对应负责人和可确认的交付物。" } },
              { "type": "icon-box", "data": { "icon": "eye", "title": "过程透明", "text": "进度、风险和待确认事项及时同步，不让问题拖到最后。" } },
              { "type": "button", "data": { "text": "认识我们的团队", "url": "/about/company.html", "variant": "outline", "align": "left" } }
            ]
          },
          {
            "elements": [
              { "type": "image", "data": { "src": "/assets/images/blox-templates/landing-brand-team.png", "alt": "企业服务团队协作" } }
            ]
          }
        ]
      },
      {
        "type": "section",
        "name": "咨询表单",
        "settings": { "padding": { "d": "xl", "m": "lg" }, "max_width": "wide", "gap": "xl", "content_v_align": "start", "bg_color": "#f8fafc" },
        "columns": [
          {
            "elements": [
              { "type": "heading", "data": { "text": "告诉我们你的目标", "level": "h2", "visual_size": { "d": "3xl", "m": "2xl" }, "align": "left" } },
              { "type": "text", "data": { "html": "<p class=\"yk-copy\">留下业务背景、目标和时间安排，我们会根据实际情况给出合适的下一步建议。</p>" } },
              { "type": "divider", "data": { "style": "solid", "width": 3, "color": "#2563eb", "spacing": "sm" } },
              { "type": "text", "data": { "html": "<p class=\"yk-note\">表单字段、邮件通知和防垃圾提交策略可在后台统一配置。</p>" } }
            ]
          },
          { "elements": [ { "type": "contact_form", "data": {} } ] }
        ]
      },
      {
        "type": "section",
        "name": "常见问题",
        "settings": { "padding": { "d": "xl", "m": "lg" }, "max_width": "narrow", "gap": "md" },
        "columns": [
          {
            "elements": [
              { "type": "heading", "data": { "text": "常见问题", "level": "h2", "visual_size": { "d": "3xl", "m": "2xl" }, "align": "center" } },
              { "type": "text", "data": { "html": "<p class=\"yk-copy yk-copy--center\">在开始合作前，先了解几个客户最常问的问题。</p>" } },
              { "type": "accordion", "data": { "open_first": true, "seo_schema": true, "items": [
                { "question": "项目启动前需要准备什么？", "answer": "准备业务目标、现状资料、期望时间和主要联系人即可，我们会协助补齐具体需求。" },
                { "question": "如何判断适合哪种服务？", "answer": "先提交你的业务背景和目标，我们会根据范围、团队和时间安排给出建议。" },
                { "question": "项目过程如何同步？", "answer": "按周或按里程碑同步进展、待确认事项和风险，频率会在启动时共同约定。" },
                { "question": "交付后是否继续支持？", "answer": "可以根据项目需要提供培训、质保、巡检和持续优化服务。" }
              ] } }
            ]
          }
        ]
      },
      {
        "type": "section",
        "name": "行动号召",
        "settings": { "padding": { "d": "lg", "m": "md" }, "max_width": "wide" },
        "columns": [
          {
            "elements": [
              { "type": "cta", "data": { "use_home_text": false, "title": "准备好开始一次清晰的合作了吗？", "text": "告诉我们目标和时间安排，我们会在一个工作日内回复。", "btn_text": "预约一次方案沟通", "btn_url": "/contact.html" } }
            ]
          }
        ]
      }
    ]
  }
}
