{
    "name": "轻量商城",
    "name_en": "Lightweight Shop",
    "name_ja": "軽量ショップ",
    "version": "0.4.0",
    "description": "给企业官网增加卖货能力：商品销售、购物车、订单、中国大陆配送范围、快递与支付。不做平台化（入驻/分销/多仓）。",
    "description_en": "Add selling power to a corporate site: product sales, cart, orders, mainland-China delivery zones, carriers and payments.",
    "description_ja": "企業サイトに販売機能を追加：商品販売・カート・受注・中国大陸の配送範囲・配送会社・決済。",
    "author": "Yikai CMS",
    "requires_php": "8.0",
    "requires_cms": "1.19.7",
    "permissions": {
        "shop_manage": {"label": "商城管理", "label_en": "Shop management", "label_ja": "ショップ管理"},
        "shop_orders": {"label": "订单处理", "label_en": "Order fulfillment", "label_ja": "受注処理"}
    },
    "admin_permission_any": ["shop_manage", "shop_orders"],
    "blox": {
        "elements": [
            {
                "type": "shop/purchase",
                "label": "商城购买组件",
                "container": false,
                "genericChild": true
            }
        ]
    }
}
