<?xml version="1.0"?>
<psalm
    errorLevel="5"
    resolveFromConfigFile="true"
    autoloader="tests/psalm-bootstrap.php"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedBaselineEntry="false"
    findUnusedIssueHandlerSuppression="false"
    findUnusedCode="true"
    errorBaseline="psalm-baseline.xml"
>
    <projectFiles>
        <file name="article.php" />
        <file name="contact.php" />
        <file name="detail.php" />
        <file name="history.php" />
        <file name="index.php" />
        <file name="list.php" />
        <file name="news.php" />
        <file name="page.php" />
        <file name="product.php" />
        <directory name="admin" />
        <directory name="config" />
        <directory name="includes" />
        <directory name="install" />
        <directory name="lang" />
        <directory name="plugins" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>

    <issueHandlers>
        <!-- 编辑页为 require 的 revision_panel.php 准备变量（include 作用域，Psalm 视为未使用；
             语句级 @psalm-suppress 对文件作用域 UnusedVariable 不生效，故在此豁免） -->
        <UnusedVariable>
            <errorLevel type="suppress">
                <file name="admin/article_edit.php" />
                <file name="admin/nav_menu.php" />
                <file name="admin/page_edit.php" />
                <file name="admin/page_edit_advance.php" />
                <file name="plugins/seo/admin.php" />
            </errorLevel>
        </UnusedVariable>
        <!-- CI 无 config.php：入口文件的 require 均在 baseline 豁免；baseline 只能在
             无 config 环境重生成（见 v1.12.0 教训），新增的独立入口在此定点豁免 -->
        <MissingFile>
            <errorLevel type="suppress">
                <file name="plugins/seo/ai.php" />
                <file name="admin/nav_menu.php" />
                <!-- 不要在此登记 admin/blox_editor.php 等不随仓库分发的文件：
                     Psalm 在解析配置时就要求 <file> 路径真实存在，文件不在仓库里
                     会直接「Could not resolve config path」导致整个 CI 红。 -->
            </errorLevel>
        </MissingFile>
        <!-- 下列公开方法的唯一调用方是 Blox 编辑器（admin/blox_editor.php、
             admin/blox_home_api.php），该编辑器已转为付费插件、不随本仓库分发，
             故在此判为「无人调用」。它们是对外 API，不是死代码，勿删。 -->
        <PossiblyUnusedMethod>
            <errorLevel type="suppress">
                <file name="includes/builder/HomeBloxDocument.php" />
                <file name="includes/builder/DynamicLoopTemplateRenderer.php" />
            </errorLevel>
        </PossiblyUnusedMethod>
    </issueHandlers>
</psalm>
